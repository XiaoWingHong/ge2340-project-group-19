services:
  label-studio:
    image: heartexlabs/label-studio:latest
    environment:
      # Copy this file to docker-compose.yml and set the public origin if you
      # terminate TLS in front of the container. For a local-only bind, use
      # http://localhost:8090 and leave the cookie flags at 0.
      LABEL_STUDIO_HOST: "http://localhost:8090"
      LABEL_STUDIO_CSRF_TRUSTED_ORIGINS: "http://localhost:8090"
      SESSION_COOKIE_SECURE: "0"
      CSRF_COOKIE_SECURE: "0"
    ports:
      - "${LS_PORT:-8090}:8080"
    volumes:
      - "${LS_DATA_DIR:-./data}:/label-studio/data"
    restart: unless-stopped
