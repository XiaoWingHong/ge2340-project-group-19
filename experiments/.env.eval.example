# Locked multi-model eval — KEY NAMES only.
# Copy to .env.eval and fill values. NEVER commit real secrets.
# chmod 600 .env.eval
# Scripts load this via --env-file (default) and never echo secret values.
#
# Online Jev is not in this set (privacy); SemIf replaces it.
# No FLASH_VARIANT / mistral_small4 / llama4_scout / flash backends.

# --- Backend selection ---
# Comma lists; omit or leave empty for all defaults.
DECISION_BACKENDS=clef,laya,kev,semif,openjev
LLM_BACKENDS=qwen38_27b,gemma4_26b_a4b,nemotron35_lightning,lfm25_24b_a2b,muse_glimmer_30b

# Caps (<=0 or unset = full locked test split)
DECISION_MAX_N=
LLM_MAX_N=

# --- Arm B: SystemOne decision backends (POST /v1/systemone) ---
# Canonical ids: clef | laya | kev | semif | openjev
# Env: {B}_BASE_URL / {B}_API_KEY / {B}_MODEL

CLEF_BASE_URL=<set-me>
CLEF_API_KEY=<set-me>
CLEF_MODEL=<set-me>

LAYA_BASE_URL=<set-me>
LAYA_API_KEY=none  # local Laya: no Bearer; use none/- /noauth
LAYA_MODEL=<set-me>

KEV_BASE_URL=<set-me>
KEV_API_KEY=<set-me>
KEV_MODEL=<set-me>

SEMIF_BASE_URL=<set-me>
SEMIF_API_KEY=<set-me>
SEMIF_MODEL=<set-me>

OPENJEV_BASE_URL=<set-me>
OPENJEV_API_KEY=<set-me>
OPENJEV_MODEL=<set-me>

# --- Arm C+: LLMs (OpenAI-compatible POST /chat/completions) ---
# Canonical ids:
#   qwen38_27b | gemma4_26b_a4b | nemotron35_lightning | lfm25_24b_a2b | muse_glimmer_30b
# Per-backend: LLM_{ID_UPPER}_BASE_URL / _API_KEY / _MODEL
# Shared few-shot; enable_thinking=false; JSON {"label","confidence"}

LLM_QWEN38_27B_BASE_URL=<set-me>
LLM_QWEN38_27B_API_KEY=<set-me>
LLM_QWEN38_27B_MODEL=<set-me>

# Legacy aliases — used only as fallback for qwen38_27b if LLM_QWEN38_27B_* unset:
LLM_BASE_URL=<set-me>
LLM_API_KEY=<set-me>
LLM_MODEL=<set-me>

LLM_GEMMA4_26B_A4B_BASE_URL=<set-me>
LLM_GEMMA4_26B_A4B_API_KEY=<set-me>
LLM_GEMMA4_26B_A4B_MODEL=<set-me>

LLM_NEMOTRON35_LIGHTNING_BASE_URL=<set-me>
LLM_NEMOTRON35_LIGHTNING_API_KEY=<set-me>
LLM_NEMOTRON35_LIGHTNING_MODEL=<set-me>

LLM_LFM25_24B_A2B_BASE_URL=<set-me>
LLM_LFM25_24B_A2B_API_KEY=<set-me>
LLM_LFM25_24B_A2B_MODEL=<set-me>

LLM_MUSE_GLIMMER_30B_BASE_URL=<set-me>
LLM_MUSE_GLIMMER_30B_API_KEY=<set-me>
LLM_MUSE_GLIMMER_30B_MODEL=<set-me>
